# Required in production. 32+ random characters, e.g. `openssl rand -base64 48`.
SECRET_KEY=
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
DATA_DIR=/var/lib/pentropy
# Set to 1 only behind a reverse proxy you control that sets X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY=1
# Optional: serve TLS directly instead of terminating at the proxy.
# TLS_CERT=/etc/ssl/pentropy/fullchain.pem
# TLS_KEY=/etc/ssl/pentropy/privkey.pem
